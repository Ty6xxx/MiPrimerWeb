# Discord Bot Token - Obtén uno en https://discord.com/developers/applications
DISCORD_TOKEN=tu_token_aqui

# Discord Application ID
CLIENT_ID=tu_client_id_aqui

# Discord Guild ID (servidor donde se usará el bot)
GUILD_ID=tu_guild_id_aqui

# Rust+ Server Configuration
RUST_SERVER_IP=127.0.0.1
RUST_SERVER_PORT=28015
RUST_PLAYER_TOKEN=tu_token_rustplus
RUST_STEAM_ID=tu_steam_id

# Configuración del bot
BOT_PREFIX=!
LOG_LEVEL=info
